# Copy to wrangler.toml (gitignored) and fill in the D1 database IDs.
# Those IDs live on the Mac mini deploy machine, not in this public repo.
#
# Preview deployments (--branch anything other than main) bind the preview
# database so they never write tester emails to production.
# A production deploy (--branch main) would bind the production database.
# Do not deploy --branch main without Randy's OK.

name = "brewdadlabs-site"
pages_build_output_dir = "site"
compatibility_date = "2026-11-04"

# Local `wrangler pages dev` uses the preview database.
[[d1_databases]]
binding = "TESTERS"
database_name = "stinkdoku-android-testers-preview"
database_id = "PREVIEW_D1_DATABASE_ID"

[[env.preview.d1_databases]]
binding = "TESTERS"
database_name = "stinkdoku-android-testers-preview"
database_id = "PREVIEW_D1_DATABASE_ID"

[[env.production.d1_databases]]
binding = "TESTERS"
database_name = "stinkdoku-android-testers"
database_id = "PRODUCTION_D1_DATABASE_ID"
